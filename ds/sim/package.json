{
  "name": "micro-ds-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Micro simulation — the interactive Micro app prototype built from @micro/ds itself (PLAN-SIM). PWA installable + one standalone HTML file.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --config vite.singlefile.config.ts && node tools/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@12.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
