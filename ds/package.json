{
  "name": "@micro/ds",
  "version": "0.1.0",
  "description": "Micro design system (batch 1 foundations): tokens, fonts, icons, Arabic i18n and shared logic. React 19, Arabic-first, RTL.",
  "type": "module",
  "license": "SEE LICENSE IN src/fonts/",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && stylelint \"src/**/*.css\" --max-warnings 0",
    "test": "vitest run",
    "tokens": "node tools/generate-tokens.mjs",
    "tokens:check": "node tools/generate-tokens.mjs --check",
    "icons": "node tools/generate-icons.mjs",
    "icons:check": "node tools/generate-icons.mjs --check",
    "fonts": "node tools/generate-fonts.mjs",
    "fonts:measure": "cd .. && uv run python ds/tools/measure-fonts.py",
    "build:standalone": "vite build --config lab/vite.config.ts && node tools/build-standalone.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "vaul": "^1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "browserslist": "^4.29.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "jsdom": "^31.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stylelint": "^16.26.1",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "browserslist": [
    "iOS >= 16.4",
    "Chrome >= 116",
    "ChromeAndroid >= 116",
    "Samsung >= 23"
  ]
}
