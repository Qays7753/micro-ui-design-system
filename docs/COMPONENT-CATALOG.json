{
  "schemaVersion": 1,
  "scope": "independent-pre-transfer-ui-system",
  "releaseTheme": "light-only",
  "chartPolicy": {
    "preciseDefault": [
      "bars",
      "rows",
      "table"
    ],
    "specializedOptIn": [
      "line",
      "donut",
      "bubbles",
      "packed-circle",
      "metric-circles",
      "main-metric-featured"
    ],
    "donutUse": "few-category-share"
  },
  "maturityVocabulary": [
    "stable-ui",
    "draft-for-review",
    "proposed"
  ],
  "families": [
    {
      "id": "buttons",
      "name": "Buttons",
      "maturity": "stable-ui",
      "preview": "previews/buttons/index.html",
      "api": "MicroButtons",
      "dependencies": []
    },
    {
      "id": "fields",
      "name": "Fields",
      "maturity": "stable-ui",
      "preview": "previews/fields/index.html",
      "api": "MicroFields",
      "dependencies": [],
      "conditionalDependencies": [
        {
          "family": "buttons",
          "when": "مسح البحث أو أزرار خطوة الكمية من B01",
          "css": [
            "components/buttons/buttons.css"
          ],
          "js": []
        }
      ]
    },
    {
      "id": "selection",
      "name": "Selection / Picker",
      "maturity": "stable-ui",
      "preview": "previews/selection/index.html",
      "api": "MicroSelection / MicroPicker",
      "dependencies": [],
      "conditionalDependencies": [
        {
          "family": "navigation",
          "when": "عرض Picker داخل طبقة حوارية",
          "css": [
            "components/navigation/navigation.css"
          ],
          "js": [
            "components/navigation/navigation.js"
          ]
        },
        {
          "family": "buttons",
          "when": "أزرار B01 في مشغّل أو طبقة Picker",
          "css": [
            "components/buttons/buttons.css"
          ],
          "js": []
        }
      ]
    },
    {
      "id": "organization",
      "name": "Organization",
      "maturity": "stable-ui",
      "preview": "previews/organization/index.html",
      "api": "MicroOrganization",
      "dependencies": [],
      "conditionalDependencies": [
        {
          "family": "buttons",
          "when": "إجراء B01 داخل الصف",
          "css": [
            "components/buttons/buttons.css"
          ],
          "js": []
        }
      ]
    },
    {
      "id": "data",
      "name": "Data",
      "maturity": "stable-ui",
      "preview": "previews/data/index.html",
      "api": "MicroData",
      "dependencies": []
    },
    {
      "id": "messages",
      "name": "Messages",
      "maturity": "stable-ui",
      "preview": "previews/messages/index.html",
      "api": "MicroMessages",
      "dependencies": [],
      "conditionalDependencies": [
        {
          "family": "buttons",
          "when": "زر B01 ضمن الرسالة أو الحالة الفارغة",
          "css": [
            "components/buttons/buttons.css"
          ],
          "js": []
        }
      ]
    },
    {
      "id": "navigation",
      "name": "Navigation",
      "maturity": "stable-ui",
      "preview": "previews/navigation/index.html",
      "api": "MicroNavigation",
      "dependencies": [],
      "conditionalDependencies": [
        {
          "family": "buttons",
          "when": "أزرار B01 في appbar أو الطبقة أو actionbar",
          "css": [
            "components/buttons/buttons.css"
          ],
          "js": []
        },
        {
          "family": "fields",
          "when": "حقول B02 في لوحة التصفية",
          "css": [
            "components/fields/fields.css"
          ],
          "js": [
            "components/fields/fields.js"
          ]
        },
        {
          "family": "selection",
          "when": "اختيارات B03 في لوحة التصفية",
          "css": [
            "components/selection/selection.css"
          ],
          "js": [
            "components/selection/selection.js"
          ]
        }
      ]
    },
    {
      "id": "surfaces",
      "name": "Surfaces",
      "maturity": "stable-ui",
      "preview": "previews/surfaces/index.html",
      "api": null,
      "dependencies": []
    },
    {
      "id": "info-strip",
      "name": "Info strip",
      "maturity": "stable-ui",
      "preview": "previews/info-strip/index.html",
      "api": "MicroInfoStrip / MicroInfoPeek",
      "dependencies": []
