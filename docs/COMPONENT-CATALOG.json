        {
          "family": "fields",
          "when": "محرر خارجي من B02 يركبه المستهلك بجوار التقويم",
          "css": [
            "components/fields/fields.css"
          ],
          "js": [
            "components/fields/fields.js"
          ]
        }
      ]
    },
    {
      "id": "carousel",
      "name": "Carousel",
      "maturity": "draft-for-review",
      "preview": "previews/carousel/index.html",
