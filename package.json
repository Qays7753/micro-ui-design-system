{
  "name": "@micro/ui",
  "version": "0.1.0",
  "private": true,
  "description": "مكتبة Micro UI — مكونات Vanilla للهاتف العربي RTL، Light-only، بدون إطار وصفر اعتماديات تشغيل.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build-package.mjs",
    "check": "node tools/build-package.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./css/micro-ui.css": "./dist/css/micro-ui.css",
    "./css/*": "./dist/css/*",
    "./js/*": "./dist/js/*",
    "./fonts/*": "./dist/fonts/*",
    "./micro-ui.d.ts": "./dist/micro-ui.d.ts"
  }
}
