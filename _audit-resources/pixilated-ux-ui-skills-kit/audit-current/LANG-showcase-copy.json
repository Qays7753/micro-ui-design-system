  "kind": "text",
  "text": "إعادة إظهار الخطأ",
  "id": "s228"
 },
 {
  "line": 863,
  "tag": "button",
  "kind": "text",
  "text": "إظهار رسالة عابرة (toast)",
  "id": "s229"
 },
 {
  "line": 864,
  "tag": "button",
  "kind": "text",
  "text": "إعلان في القناة الحيّة (polite)",
  "id": "s230"
 },
 {
  "line": 869,
  "tag": "span",
  "kind": "text",
  "text": "جارٍ تجهيز التقرير...",
  "id": "s231"
 },
 {
  "line": 880,
  "tag": "span",
  "kind": "text",
  "text": "لا توجد بيانات بعد",
  "id": "s232"
 },
 {
  "line": 881,
  "tag": "p",
  "kind": "text",
